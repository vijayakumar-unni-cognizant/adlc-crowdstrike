<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/adlc-crowdstrike/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="adlc-crowdstrike/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="adlc-crowdstrike/components/container"
            layout="simple">
            <site_header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adlc-crowdstrike/components/site-header"
                logoReference="/content/dam/adlc-crowdstrike/racing/about-us/crowdstrike-racing-logo.svg"
                logoAlt="CrowdStrike Racing Logo"
                homeUrl="/"
                navigationLabel="Primary navigation"
                menuLabel="Menu"
                closeLabel="Close menu"
                teamLabel="The Team"
                teamUrl="/sports-car/teams-and-drivers/">
                <teamItems jcr:primaryType="nt:unstructured">
                    <item0 jcr:primaryType="nt:unstructured" label="Drivers" url="/sports-car/teams-and-drivers/"/>
                    <item1 jcr:primaryType="nt:unstructured" label="Schedule" url="/sports-car/schedules/"/>
                    <item2 jcr:primaryType="nt:unstructured" label="Awards" url="/sports-car/awards/"/>
                </teamItems>
                <primaryItems jcr:primaryType="nt:unstructured">
                    <item0 jcr:primaryType="nt:unstructured" label="CXO Summits" url="/cxo-summits/"/>
                    <item1 jcr:primaryType="nt:unstructured" label="Photo Gallery" url="/photo-gallery/"/>
                    <item2 jcr:primaryType="nt:unstructured" label="About Us" url="/content/adlc-crowdstrike/us/en/about-us.html" active="{Boolean}true"/>
                </primaryItems>
            </site_header>
        </root>
    </jcr:content>
</jcr:root>
