<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/adlc-crowdstrike/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Footer"
        sling:resourceType="adlc-crowdstrike/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="adlc-crowdstrike/components/container"
            layout="responsiveGrid">
            <site_footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adlc-crowdstrike/components/site-footer"
                logoReference="/content/dam/adlc-crowdstrike/racing/about-us/crowdstrike-racing-logo.svg"
                logoAlt="CrowdStrike Racing Logo"
                homeUrl="/"
                racingGroupTitle="CrowdStrike Racing"
                whyGroupTitle="Why CrowdStrike?"
                socialGroupTitle="Follow us!"
                copyrightText="Copyright © 2025">
                <racingLinks jcr:primaryType="nt:unstructured">
                    <item0 jcr:primaryType="nt:unstructured" label="Home" url="/"/>
                    <item1 jcr:primaryType="nt:unstructured" label="Swag Shop" url="https://www.crowdstrikeswag.com/" openInNewTab="{Boolean}true"/>
                </racingLinks>
                <whyLinks jcr:primaryType="nt:unstructured">
                    <item0 jcr:primaryType="nt:unstructured" label="About CrowdStrike" url="https://www.crowdstrike.com/" openInNewTab="{Boolean}true"/>
                    <item1 jcr:primaryType="nt:unstructured" label="Services" url="https://www.crowdstrike.com/en-us/services/" openInNewTab="{Boolean}true"/>
                    <item2 jcr:primaryType="nt:unstructured" label="Industry Validation" url="https://www.crowdstrike.com/en-us/why-crowdstrike/crowdstrike-industry-validation/" openInNewTab="{Boolean}true"/>
                    <item3 jcr:primaryType="nt:unstructured" label="Our Customers" url="https://www.crowdstrike.com/en-us/resources/customer-stories/" openInNewTab="{Boolean}true"/>
                </whyLinks>
            </site_footer>
        </root>
    </jcr:content>
</jcr:root>
