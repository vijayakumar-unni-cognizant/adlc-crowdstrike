{"jcr:primaryType":"cq:Page","jcr:createdBy":"admin","jcr:created":"Fri Sep 04 2026 05:39:50 GMT+0000","jcr:content":{"jcr:primaryType":"cq:PageContent","jcr:mixinTypes":["mix:referenceable"],"jcr:createdBy":"admin","jcr:title":"About Us","description":"Learn how CrowdStrike Racing brings speed, resilience and teamwork together on the track and in cybersecurity.","ogImage":"/content/dam/adlc-crowdstrike/racing/about-us/about-us-hero-interior.png","ogTitle":"About Us | CrowdStrike Racing","canonicalUrl":"https://crowdstrikeracing.com/about-us/","cq:template":"/conf/adlc-crowdstrike/settings/wcm/templates/racing-page","jcr:created":"Fri Sep 04 2026 05:39:50 GMT+0000","ogUrl":"https://crowdstrikeracing.com/about-us/","pageTitle":"About Us | CrowdStrike Racing","jcr:uuid":"13a43ca0-8921-4905-a5db-253f13a5de67","sling:resourceType":"adlc-crowdstrike/components/page","ogDescription":"Learn how CrowdStrike Racing brings speed, resilience and teamwork together on the track and in cybersecurity.","root":{"jcr:primaryType":"nt:unstructured","layout":"responsiveGrid","sling:resourceType":"adlc-crowdstrike/components/container","container":{"jcr:primaryType":"nt:unstructured","sling:resourceType":"adlc-crowdstrike/components/container","hero":{"jcr:primaryType":"nt:unstructured","layout":"responsiveGrid","sling:resourceType":"adlc-crowdstrike/components/container","cq:styleIds":["20260902011"],"about_us_hero":{"jcr:primaryType":"nt:unstructured","fileReference":"/content/dam/adlc-crowdstrike/racing/about-us/about-us-hero-interior.png","imageAlt":"CrowdStrike Racing drivers celebrating together after a win","fetchPriority":"high","title":"About Us","imageLoading":"eager","sling:resourceType":"adlc-crowdstrike/components/teaser","altValueFromDAM":false,"cq:styleIds":["20260902001"]}},"container":{"jcr:primaryType":"nt:unstructured","layout":"responsiveGrid","sling:resourceType":"adlc-crowdstrike/components/container","cq:styleIds":["20260902012"],"we_stop_breaches":{"jcr:primaryType":"nt:unstructured","fileReference":"/content/dam/adlc-crowdstrike/racing/about-us/we-stop-breaches.png","actionsEnabled":true,"imageAlt":"No. 04 CrowdStrike prototype racing at speed","title":"We Stop Breaches","jcr:description":"<p>CrowdStrike has redefined modern security with the industryâ€™s most advanced agentic security platform, unifying protection across endpoints, cloud workloads, identity, and data. The CrowdStrike Falcon Platform brings AI-driven automation and real-time intelligence to the SOC, combining human expertise with machine-speed action to stop breaches and protect the people, organizations, and technologies shaping the future.</p>","imageLoading":"lazy","sling:resourceType":"adlc-crowdstrike/components/teaser","textIsRich":true,"altValueFromDAM":false,"cq:styleIds":["20260902002","20260902003","20260902005"],"actions":{"jcr:primaryType":"nt:unstructured","item0":{"jcr:primaryType":"nt:unstructured","link":"https://www.crowdstrike.com/","text":"Learn more about CrowdStrike"}}},"why_we_race":{"jcr:primaryType":"nt:unstructured","fileReference":"/content/dam/adlc-crowdstrike/racing/about-us/why-we-race.png","imageAlt":"CrowdStrike Racing crew performing a nighttime pit stop on the No. 04 car","title":"Why We Race","jcr:description":"<p>Performance under pressure defines both cybersecurity and world-class racing. Speed, agility, and resilience are critical when staying ahead of rapidly-evolving threats, on and off the track.</p><p>CrowdStrike, in partnership with AWS, convenes C-level cybersecurity leaders at premier race weekends around the world to explore how operational excellence and teamwork drive sustained performance in high-stakes environments.</p>","imageLoading":"lazy","sling:resourceType":"adlc-crowdstrike/components/teaser","textIsRich":true,"altValueFromDAM":false,"cq:styleIds":["20260902002","20260902004","20260902006"]},"racing_by_apr":{"jcr:primaryType":"nt:unstructured","fileReference":"/content/dam/adlc-crowdstrike/racing/about-us/crowdstrike-racing-by-apr.png","imageAlt":"No. 04 CrowdStrike prototype competing in a daylight race","title":"CrowdStrike Racing by APR","jcr:description":"<p>CrowdStrike Racing competes globally in premier sports car championships in the LMP2 prototype class. In IMSA competition, the team partners with technical powerhouse APR (Algarve Pro Racing) as â€œCrowdStrike Racing by APR.â€ The partnership has delivered landmark victories, including a class win at the 2026 24 Hours of Daytona and championship-winning success in the Asian Le Mans Series. Together, CrowdStrike Racing by APR continues to set the pace in prototype endurance racing worldwide.</p>","imageLoading":"lazy","sling:resourceType":"adlc-crowdstrike/components/teaser","textIsRich":true,"altValueFromDAM":false,"cq:styleIds":["20260902002","20260902003","20260902005"]},"oreca_07":{"jcr:primaryType":"nt:unstructured","fileReference":"/content/dam/adlc-crowdstrike/racing/about-us/no-4-crowdstrike-oreca-07.png","imageAlt":"No. 04 CrowdStrike prototype racing through mist at night","title":"No. 4 CrowdStrike Oreca 07","jcr:description":"<p>The ORECA 07 is a closed-cockpit sports car built to the current Le Mans Prototype 2 (LMP2) technical regulations. The car is present in all major championships sanctioned by the FIA and ACO (Automobile Club de lâ€™Ouest) with more than 30 victories around the world.</p><ul><li>Engine: Gibson GK-428, 4.2-liter V8, approx. 600 hp</li><li>Gearbox: 6-speed sequential Xtrac 1152 with paddle-shift system</li><li>Chassis: Carbon fiber and honeycomb monocoque</li></ul>","imageLoading":"lazy","sling:resourceType":"adlc-crowdstrike/components/teaser","textIsRich":true,"altValueFromDAM":false,"cq:styleIds":["20260902002","20260902004","20260902006"]}}}}}}